{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Imglyze",
  "version": "0.1.0",
  "identifier": "com.brunof2p.imglyze",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Imglyze",
        "width": 1200,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 700,
        "center": true,
        "decorations": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "transparent": false,
        "fullscreen": false,
        "focus": true,
        "visible": true,
        "theme": null,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    },
    "enableGTKAppId": true,
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [],
        "files": {}
      },
      "appimage": {
        "bundleMediaFramework": false,
        "files": {}
      }
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": null,
      "timestampUrl": null
    }
  }
}