{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "core:window:allow-set-title",
    "core:path:default",
    "core:event:default",
    "dialog:allow-open",
    "store:default",
    "store:allow-load",
    "store:allow-save",
    "store:allow-get",
    "store:allow-set",
    "opener:allow-reveal-item-in-dir",
    "notification:default",
    "core:window:allow-is-focused"
  ]
}
